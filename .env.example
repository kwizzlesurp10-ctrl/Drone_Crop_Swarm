# ========================================
# AetherAg Orbit - Environment Configuration
# ========================================

# -------------------------------------
# Database Configuration
# -------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aetherag_orbit

# -------------------------------------
# Supabase Configuration
# -------------------------------------
# Get these from https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key-here

# -------------------------------------
# API Configuration
# -------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
SECRET_KEY=your-secret-key-for-jwt-signing-min-32-chars

# -------------------------------------
# Mapbox Configuration
# -------------------------------------
# Get your token from https://account.mapbox.com/
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-token-here

# -------------------------------------
# AI Models Configuration
# -------------------------------------
YOLO_MODEL_PATH=./models/yolov10n.pt
SAM2_CHECKPOINT=./models/sam2_checkpoint.pt

# -------------------------------------
# Storage Configuration (Supabase Storage or S3)
# -------------------------------------
STORAGE_BUCKET=drone-images
NEXT_PUBLIC_STORAGE_URL=https://your-project.supabase.co/storage/v1/object/public

# -------------------------------------
# Redis Configuration (Optional)
# -------------------------------------
REDIS_URL=redis://localhost:6379

# -------------------------------------
# Application Configuration
# -------------------------------------
NODE_ENV=development
PORT=3000
API_PORT=8000

# -------------------------------------
# Authentication
# -------------------------------------
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# -------------------------------------
# CORS Configuration
# -------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# -------------------------------------
# Logging
# -------------------------------------
LOG_LEVEL=info

# -------------------------------------
# Feature Flags
# -------------------------------------
ENABLE_AI_ANALYSIS=true
ENABLE_REALTIME_TELEMETRY=true
